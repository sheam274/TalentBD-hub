# --- Server-only secrets (required for AI + jobs sync locally) ---
# On Lovable Cloud these are auto-injected. For localhost you must set them.

# Lovable AI Gateway (chat, Gemini coach, CV assist).
# Get a free key at https://ai.google.dev/ then paste here — or
# use your own Gemini API key.
GOOGLE_GEMINI_API_KEY=""
LOVABLE_API_KEY=""

# Random string used to authenticate the external jobs sync endpoint.
# Generate with: openssl rand -hex 32
JOBS_SYNC_SECRET=""

# Supabase admin (service role) — REQUIRED only if you run admin server functions locally.
# NOT available on Lovable Cloud (managed). Ask a project owner if needed.
SUPABASE_SERVICE_ROLE_KEY=""